# Rendered and sliced output: build products, made again from the .scad sources whenever needed.
*.stl
*.3mf
*.gcode
*.echo
*.step

# scad-check's part files and output, and scad-preview's.
.check/
preview/

# The one-file parts scad-tools/scripts/printables.py makes for Printables, from the sources.
/printables/

# OpenSCAD Customizer parameter sets: the .scad files are the source of truth.
*.json

# Vendor datasheets and other third-party documents are someone else's copyright: extract the data into
# Markdown and link where the original came from.
*.pdf
*.PDF
